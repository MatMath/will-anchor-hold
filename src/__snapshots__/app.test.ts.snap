exports[`app renders the same output (golden master) > defaults > warnings 1`] = `
"
    <div class="alert alert-amber"><strong>Check the set-up</strong><ul><li>In the gust, all the chain is lifted off the seabed: the anchor is pulled upward and may break out.</li></ul></div>
    <div class="alert alert-info">
      <strong>⚠ These are static loads.</strong> A gust or a wave snatch load can be several times the static load. Turn on <strong>waves</strong> and, when swinging, <strong>fishtailing</strong> to see them.
      A sudden gust on an elastic mooring can overshoot to about <strong>13.6 kN</strong> of wind load (2 × the gust increment).
      A 0.5 m/s surge stopped by the mooring adds about <strong>6.13 kN</strong>.
      A nylon <strong>snubber</strong>, or longer nylon stern lines, adds elasticity and cuts snatch loads sharply. Try one in the Snubber section.
    </div>"
`;

exports[`app renders the same output (golden master) > medWavesSnubber > facts 1`] = `"<div><span>Bow tension</span><strong>2.68 kN</strong></div><div><span>At anchor</span><strong>2.57 kN</strong></div><div><span>Lifted</span><strong>39.9 of 40 m</strong></div><div><span>Uplift at anchor</span><strong>0.0°</strong></div><div><span>Anchor pull</span><strong>horizontal</strong></div>"`;

