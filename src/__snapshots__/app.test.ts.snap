exports[`app renders the same output (golden master) > swingWavesFishtail > warnings 1`] = `
"
    <div class="alert alert-amber"><strong>Check the set-up</strong><ul><li>No stern lines: the boat swings on its anchor and lies head to wind. Allow swinging room — it can sweep a circle of chain span + boat length.</li><li>In the gust, all the chain is lifted off the seabed: the anchor is pulled upward and may break out.</li><li>Waves / fishtailing more than double the chain load (fishtail ±25° + largest wave 0.7 m). Lengthen the scope or fit a nylon snubber.</li></ul></div>
    <div class="alert alert-info">
      <strong>⚠ Peaks include fishtail ±25° + largest wave 0.7 m.</strong> They are quasi-static estimates plus a simplified surge simulation; real snatch loads scatter widely.
      A sudden gust on an elastic mooring can overshoot to about <strong>5.35 kN</strong> of wind load (2 × the gust increment).
      A 0.5 m/s surge stopped by the mooring adds about <strong>6.03 kN</strong>.
      A nylon <strong>snubber</strong>, or longer nylon stern lines, adds elasticity and cuts snatch loads sharply. Try one in the Snubber section.
    </div>"
`;

exports[`app renders the same output (golden master) > workedKgf > facts 1`] = `"<div><span>Bow tension</span><strong>764 kgf</strong></div><div><span>At anchor</span><strong>750 kgf</strong></div><div><span>Lifted</span><strong>40.0 of 40 m</strong></div><div><span>Uplift at anchor</span><strong>7.6°</strong></div><div><span>Anchor pull</span><strong><strong class="warn-text">⚠ upward</strong></strong></div>"`;

