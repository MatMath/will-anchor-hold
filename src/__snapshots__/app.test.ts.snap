exports[`app renders the same output (golden master) > medWavesSnubber > warnings 1`] = `
"
    <div class="alert alert-amber"><strong>Check the set-up</strong><ul><li>In the gust, all the chain is lifted off the seabed: the anchor is pulled upward and may break out.</li></ul></div>
    <div class="alert alert-info">
      <strong>⚠ Peaks include largest wave 0.9 m.</strong> They are quasi-static estimates plus a simplified surge simulation; real snatch loads scatter widely.
      A sudden gust on an elastic mooring can overshoot to about <strong>14.1 kN</strong> of wind load (2 × the gust increment).
      A 0.5 m/s surge stopped by the mooring adds about <strong>6.98 kN</strong>.
      Your snubber lowers the mooring stiffness and so the snatch load.
    </div>"
`;

exports[`app renders the same output (golden master) > swingWavesFishtail > facts 1`] = `"<div><span>Bow tension</span><strong>3.05 kN</strong></div><div><span>At anchor</span><strong>2.91 kN</strong></div><div><span>Lifted</span><strong>40.0 of 40 m</strong></div><div><span>Uplift at anchor</span><strong>3.2°</strong></div><div><span>Anchor pull</span><strong><strong class="warn-text">⚠ upward</strong></strong></div>"`;

exports[`app renders the same output (golden master) > swingWavesFishtail > plan 1`] = `
